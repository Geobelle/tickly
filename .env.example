# Public Clerk client key (test key for local development; use the live key for production).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Public PostHog project ingestion key. Never put a PostHog personal API key here.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# Keep this aligned with the PostHog project region or self-hosted deployment.
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
