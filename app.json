{
  "expo": {
    "name": "tickly",
    "slug": "tickly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/loveMascot.png",
    "scheme": "tickly",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F3",
        "foregroundImage": "./assets/images/loveMascot.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/loveMascot.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f3",
          "image": "./assets/images/mascot.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ComicNeue-Bold.ttf",
            "./assets/fonts/ComicNeue-BoldItalic.ttf",
            "./assets/fonts/ComicNeue-Italic.ttf",
            "./assets/fonts/ComicNeue-Light.ttf",
            "./assets/fonts/ComicNeue-LightItalic.ttf",
            "./assets/fonts/ComicNeue-Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
